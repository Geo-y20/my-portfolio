# Copy to .env (local) or set in Vercel → Settings → Environment Variables.
# Names only — never commit real values.

# Ask AI chat (OpenRouter)
OPENROUTER_API_KEY=
# Optional: comma-separated model chain override
OPENROUTER_MODELS=

# Neon object storage (S3-compatible). Vercel reserves AWS_* names, so
# production must use these NEON_S3_* names. Locally, AWS_ENDPOINT_URL_S3 /
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_REGION also work as fallbacks.
NEON_S3_ENDPOINT=
NEON_S3_ACCESS_KEY_ID=
NEON_S3_SECRET_ACCESS_KEY=
NEON_S3_REGION=
NEON_S3_BUCKET=

# Optional: serve media straight from a public bucket/CDN instead of /api/media
NEXT_PUBLIC_MEDIA_BASE_URL=
# Optional: canonical site origin (defaults to the current Vercel URL)
NEXT_PUBLIC_SITE_URL=
